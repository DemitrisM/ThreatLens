docs/usage.md
docs/scoring.md
docs/cli_redesign_plan.md

__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
# setuptools leaves this behind after `pip install .` — comment on its own
# line, because .gitignore has no inline comments: a trailing `#` is part of
# the pattern, so `build/  # note` matches nothing and silently ignores
# nothing.
build/

# Bind-mount sources for docker compose. The directories themselves are
# tracked (via .gitkeep) because Docker creates a missing bind-mount source
# as root:root on the host; their contents are not.
reports/*
!reports/.gitkeep
samples/*
!samples/.gitkeep
tests/samples/

config.yaml

# External binaries (downloaded by install.sh)
bin/capa
bin/floss

# Downloaded YARA rule sets (managed by update-rules command)
rules/yara/signature-base/
rules/yara/eset-malware-ioc/
rules/yara/.rule_sources.json

UI_Report

# Holds a real VirusTotal key. The .example template is tracked instead.
.env

# peepdf writes <sample>-<timestamp>-peepdf-jserrors.txt into the working
# directory. pdf_analysis now parses inside a scratch directory it owns, so
# these should never appear — but the fallback path when that directory
# cannot be created still parses in place, so this is belt and braces.
*-peepdf-jserrors.txt
