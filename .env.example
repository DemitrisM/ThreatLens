# Copy to .env before the first `docker compose run`.
#
#   cp .env.example .env
#   printf 'TL_UID=%s\nTL_GID=%s\n' "$(id -u)" "$(id -g)" >> .env

# Your own uid/gid. entrypoint.sh chowns the mounts to these and drops
# privileges to them, so reports land on the host owned by you rather than by
# uid 1000. Without this, a host user whose id is not 1000 gets reports they
# need sudo to delete.
TL_UID=1000
TL_GID=1000

# VirusTotal API key. Optional — every module except `virustotal` works
# without it, and a failed or absent lookup scores 0 either way, so it moves
# no verdict. Never commit a real key: .env is gitignored.
THREATLENS_VT_KEY=
