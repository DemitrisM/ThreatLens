# Copy to .env before the first `docker compose run`.
#
#   cp .env.example .env
#   printf 'TL_UID=%s\nTL_GID=%s\n' "$(id -u)" "$(id -g)" >> .env

# Your own uid/gid, and the two lines below are deliberately commented out so
# that the `printf` above is the only thing that sets them. They used to ship
# uncommented at 1000, which meant following the two steps in order produced a
# .env declaring each key twice — harmless, since the last occurrence wins, but
# a user whose id is not 1000 opened the file, found TL_UID=1000 followed by
# TL_UID=1001 with nothing to say which applied, and deleted one at random.
# Deleting the wrong one is silent and restores the exact problem these keys
# exist to prevent.
#
# entrypoint.sh chowns the mounts to these and drops privileges to them, so
# reports land on the host owned by you. Leave them unset and both default to
# 1000, so a host user whose id is not 1000 gets reports they need sudo to
# delete. Run the printf, or uncomment these and put your own `id -u` / `id -g`
# in — one or the other, not both.
#
#TL_UID=1000
#TL_GID=1000

# VirusTotal API key. Optional — every module except `virustotal` works
# without it, and a failed or absent lookup scores 0 either way, so it moves
# no verdict. Never commit a real key: .env is not tracked.
THREATLENS_VT_KEY=
